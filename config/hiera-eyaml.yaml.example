---
version: 5

defaults:
  datadir: data
  data_hash: yaml_data

hierarchy:
  - name: Encrypted per-node data
    lookup_key: eyaml_lookup_key
    path: "../secrets/nodes/%{trusted.certname}.eyaml"
    options:
      pkcs7_private_key: /etc/sasd-puppet/eyaml/private_key.pkcs7.pem
      pkcs7_public_key: /etc/sasd-puppet/eyaml/public_key.pkcs7.pem

  - name: Per-node data
    path: "nodes/%{trusted.certname}.yaml"

  - name: Operating system and major release
    path: "os/%{facts.os.name}/%{facts.os.release.major}.yaml"

  - name: Operating system
    path: "os/%{facts.os.name}.yaml"

  - name: Operating-system family
    path: "os/family/%{facts.os.family}.yaml"

  - name: Common data
    path: common.yaml
