    },
    "Debian 13": {
      "strategy": "microsoft",
      "architecture": "amd64",
      "config_package_url": "https://packages.microsoft.com/config/debian/13/packages-microsoft-prod.deb",
      "expected_package": "packages-microsoft-prod"
    },
    "Ubuntu 24.04": {
      "strategy": "distribution",
      "architecture": "amd64",
      "package": "dotnet-sdk-10.0"
    },
    "AlmaLinux 9": {
      "strategy": "distribution",
      "architecture": "x86_64",
      "package": "dotnet-sdk-10.0"
