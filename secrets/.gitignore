# Never commit generated PKCS7 keys or plaintext scratch files.
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.plain
*.decrypted

# Encrypted eyaml files are allowed after explicit review.
!*.eyaml
!**/*.eyaml
!README.md
!examples/
!examples/*.example

!nodes/
!nodes/*.eyaml
!nodes/README.md
!examples/*.eyaml.example
