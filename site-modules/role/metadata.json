{
  "name": "sasd-role",
  "version": "0.5.0",
  "author": "SASD SysAdmin",
  "summary": "SASD node roles for the puppet-software-baseline control repository.",
  "license": "MIT",
  "source": "https://github.com/SASD-Sysadmin/puppet-software-baseline",
  "project_page": "https://github.com/SASD-Sysadmin/puppet-software-baseline",
  "issues_url": "https://github.com/SASD-Sysadmin/puppet-software-baseline/issues",
  "dependencies": [
    {
      "name": "sasd-profile",
      "version_requirement": ">= 0.5.0 < 1.0.0"
    }
  ],
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 7.23.0 < 9.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "12",
        "13"
      ]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "24.04"
      ]
    }
  ]
}
