[Unit]
Description=Deploy the production Puppet environment with r10k
Documentation=https://github.com/SASD-Sysadmin/puppet-software-baseline
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0027
ExecStart=/usr/bin/env /usr/local/libexec/sasd-puppet/deploy-environment.sh --environment production --branch production
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=false

[Install]
WantedBy=multi-user.target
